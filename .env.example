# SentinelGraph Environment Configuration

# Project
ENVIRONMENT=development
DEBUG=true

# Groq LLM Configuration (Groq only)
# Leave empty or set to test offline deterministic mode with zero API key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USE_MOCK_LLM=false

# Database Configuration
# Local development: SQLite file, created and migrated automatically (Alembic) on startup.
# Any PostgreSQL URL also works, e.g. a free Neon / Render Postgres for a persistent deployment:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./sentinelgraph.db

# PostgreSQL credentials (Docker Compose only). Choose your own password — there is no default.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=sentinelgraph_db
