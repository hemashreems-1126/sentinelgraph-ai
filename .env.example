# SentinelGraph Environment Configuration

# Project
ENVIRONMENT=development
DEBUG=true

# Groq LLM Configuration (Groq only)
# Leave empty or set to test offline deterministic mode with zero API key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USE_MOCK_LLM=false

# Database Configuration
# In Docker Compose, this is automatically configured to PostgreSQL
# In local development without Docker, SQLite fallback is supported
DATABASE_URL=sqlite:///./sentinelgraph.db

# PostgreSQL credentials (for Docker Compose)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret_2026
POSTGRES_DB=sentinelgraph_db
